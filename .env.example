# Variables de entorno de AstroGuide.
# Copia este archivo a ".env" (no se sube a git) y ajusta los valores.
# En desarrollo funciona con los valores por defecto; define estas en PRODUCCION.

# Clave secreta de Django. Genera una nueva para produccion:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto-en-produccion

# Modo debug: True en desarrollo, False en produccion.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma (ej. midominio.com,www.midominio.com).
DJANGO_ALLOWED_HOSTS=*

# Origenes de confianza para CSRF en produccion (con https://), separados por coma.
# En Render se autoconfigura con el dominio *.onrender.com; solo hace falta con dominio propio.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Conexion a la base de datos (produccion). En local, si se omite, usa SQLite.
# En Render se inyecta sola desde la base Postgres del blueprint.
DATABASE_URL=

# API key de la NASA para la "imagen del dia" (APOD).
# DEMO_KEY funciona pero tiene limite; pide la tuya gratis en https://api.nasa.gov
NASA_API_KEY=DEMO_KEY
